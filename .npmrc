# vitest 5 declara un peer opcional @types/node ^22 || >=24 y el proyecto fija ^20, que es
# el runtime real de desarrollo. Es un conflicto solo de tipos, asi que se acepta igual que
# en local: el package-lock.json se genero con esta misma resolucion. Sin este archivo,
# `npm install` sin flags (el de Vercel) falla con ERESOLVE.
legacy-peer-deps=true
